# Copy to .env and fill in the three CRITICAL values from Poolside admin.
# Never commit the real .env (it has the bridge_secret in plaintext).

# === Cloud (don't change unless Poolside support tells you to) ===
SUPABASE_URL=https://sdewylbddkcvidwosgxo.supabase.co

# === This bridge's identity (from Poolside admin → Settings → 🔐 Remote keyfob access) ===
# Click "Rotate bridge secret" — a popup shows both values. Paste them here.
# Plaintext only appears ONCE; if you lose it, rotate again.
BRIDGE_ID=PASTE_BRIDGE_ID_FROM_POOLSIDE_ADMIN
BRIDGE_SECRET=PASTE_BRIDGE_SECRET_FROM_POOLSIDE_ADMIN

# === Tunables (defaults are fine for most clubs) ===
POLL_SEC=1.5
HEARTBEAT_SEC=30
STALE_COMMAND_SEC=60
