# Normalize line endings. Windows tooling (tools/supabase.exe, Windows editors)
# was rewriting tracked files with CRLF, turning small changes into 20k-line
# diffs. Everything text is stored and checked out as LF.
* text=auto eol=lf

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf

# Binaries — never touch.
*.png   binary
*.exe   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.pdf   binary
